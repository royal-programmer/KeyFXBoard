<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KeyFXBoard.App.PromptDialog"
        Icon="/Assets/app.ico"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        TransparencyLevelHint="Mica,AcrylicBlur,None"
        Background="#CC1C1C1C">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,16,0,0">
      <Button Content="Cancel" MinWidth="88" Click="OnCancel"/>
      <Button Content="Save" MinWidth="88" Click="OnOk"/>
    </StackPanel>
    <StackPanel Spacing="10">
      <TextBlock x:Name="PromptText" TextWrapping="Wrap"/>
      <TextBox x:Name="NameBox" Width="360" HorizontalAlignment="Left"/>
      <TextBlock x:Name="ErrorText"
                 Foreground="#E07070"
                 TextWrapping="Wrap"
                 IsVisible="False"/>
    </StackPanel>
  </DockPanel>
</Window>
